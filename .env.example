DATABASE_URL=postgres://innogen:innogen@localhost:5432/innogen?sslmode=disable
REDIS_ADDR=localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
PISTON_BASE_URL=http://localhost:2000
AUTH_SERVICE_URL=http://localhost:8081
RUN_SERVICE_URL=http://localhost:8082
SUBMISSION_SERVICE_URL=http://localhost:8083
FORUM_SERVICE_URL=http://localhost:8084
AI_SERVICE_URL=http://localhost:8085
AI_INTERNAL_SECRET=replace-with-a-separate-long-random-secret
# Leave these empty to prevent live AI calls. Tests use a local HTTP double.
# Full OpenAI-compatible chat completions endpoint, not a base URL.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=
AI_ENABLED_SINCE=

# Comma-separated browser origins allowed for CORS and state-changing auth
# requests (refresh/logout). Requests from other browser origins are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Domain attribute for the refresh-token cookie (for example
# ".example.com" to share it across subdomains). Leave empty for host-only.
REFRESH_COOKIE_DOMAIN=

# Password-reset email delivery. Leave SMTP_HOST empty in development to skip
# real delivery; the API still returns the same generic 202 response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Key used to HMAC password-reset OTPs before persistence. Prefer a dedicated
# secret; JWT_SECRET is used as a fallback when empty.
OTP_SECRET=replace-with-a-separate-random-secret

# Reset OTP lifetime (minutes) and failed verification attempts allowed before
# the code is invalidated.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_ATTEMPTS=5
